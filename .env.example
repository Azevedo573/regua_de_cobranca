# ============================================================================
# CONFIGURAÇÃO WhatsApp - Integração com API
# ============================================================================

# URL base da API WhatsApp (OBRIGATÓRIO)
# Exemplo: https://seu-servidor.azurewebsites.net
WHATSAPP_API_URL=

# Token de autenticação Bearer (OBRIGATÓRIO)
# Solicite ao provedor da API
WHATSAPP_AUTH_TOKEN=

# ============================================================================
# TEMPLATES WhatsApp - Template de Cobrança
# ============================================================================

# Template ID para cobrança
# Formato: 
# Copie exatamente do Portal
# Parâmetros: {{1}}=nome_cliente, {{2}}=valor, {{3}}=data_vencimento
WHATSAPP_TEMPLATE_COBRANCA=

# ============================================================================
# INSTRUÇÕES DE USO
# ============================================================================

# 1. COPIE este arquivo para ".env" (sem o .example)
#    cp .env.example .env
#
# 2. SUBSTITUA os valores:
#    - WHATSAPP_API_URL: URL do seu servidor
#    - WHATSAPP_AUTH_TOKEN: Token fornecido pelo provedor
#    - WHATSAPP_TEMPLATE_*: IDs das templates no portal
#
# 3. GUARDE .env em local SEGURO (não commite em git)
#
# 4. EXECUTE a aplicação:
#    streamlit run app.py

# ============================================================================
# COMO OBTER O ID DA TEMPLATE
# ============================================================================

# 1. Acesse o portal WhatsApp
# 2. Vá em Templates/Mensagens
# 3. Encontre sua template de cobrança
# 4. Copie o ID (formato: cb71990515:template:141744687)
# 5. Cole em WHATSAPP_TEMPLATE_COBRANCA acima

